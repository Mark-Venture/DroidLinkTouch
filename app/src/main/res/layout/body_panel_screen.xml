<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    android:orientation="horizontal"
    android:padding="6dp" >

    <!-- Home / Return Button -->
    <ImageButton
        android:id="@+id/home_Button"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="4dp"
        android:layout_weight="0.07"
        android:background="@null"
        android:scaleType="fitStart"
        android:src="@drawable/button_image" />

    <!-- Left Interactive Body Wireframe Graphic -->
    <FrameLayout
        android:id="@+id/body_wireframe_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="6dp"
        android:layout_weight="0.35" >

        <ImageView
            android:id="@+id/imageView_Selection_Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/body_selection_layer"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imageView_Body_Panels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/body_panel_wireframe" />

        <ImageView
            android:id="@+id/imageView_Body_Highlights"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Right Control Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical" >

        <!-- Top Selection & Action Bar for Wireframe (Double Height + Enlarged Text) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/frame_attempt_2"
            android:orientation="vertical"
            android:padding="8dp" >

            <!-- Row 1: Quick Select Buttons + Sync (60dp height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/label_select_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:text="SELECT:"
                    android:textColor="#f6b93f"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_none"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="NONE"
                    android:textColor="#ff6666"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_doors"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.05"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="DOORS"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_arms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="0.95"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ARMS"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_drawers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="DRAWERS"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_all"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="0.85"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ALL"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sync_dl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.95"
                    android:background="@drawable/sound_button_image"
                    android:padding="2dp"
                    android:text="SYNC"
                    android:textColor="#6bc7eb"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: Actions on Selected Panels + Master All Open/Close (64dp height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/label_selected_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:text="SELECTED:"
                    android:textColor="#6bc7eb"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.05"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="OPEN"
                    android:textColor="#00ff00"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.05"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="CLOSE"
                    android:textColor="#ff6666"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="TOGGLE"
                    android:textColor="#e0ca64"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_master_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ALL OPEN"
                    android:textColor="#00ff00"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_master_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ALL CLOSE"
                    android:textColor="#ff6666"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Single Panel of Customizable Sequence Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/frame_attempt_2"
            android:orientation="vertical"
            android:padding="8dp" >

            <TextView
                android:id="@+id/body_seq_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="4dp"
                android:text="BODY SEQUENCES:"
                android:textColor="#f6b93f"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Row 1: Sequences 1, 2, 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/button_bseq_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="UTIL ARMS WAVE"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="FRONT DOORS"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="REAR DOORS"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 2: Sequences 4, 5, 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/button_bseq_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DOORS OPEN"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DOORS CLOSE"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DRAWERS 1-3"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 3: Sequences 7, 8, 9 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/button_bseq_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DRAWERS 4-7"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DRAWERS OPEN"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DRAWERS CLOSE"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 4: Sequences 10, 11, 12 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/button_bseq_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="SEQ 10"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_11"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="SEQ 11"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_bseq_12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="SEQ 12"
                    android:textColor="#e0ca64"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Status Line -->
        <TextView
            android:id="@+id/body_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Tap panels on wireframe to select + OPEN/CLOSE/TOGGLE, or tap a Sequence button"
            android:textColor="#a0a0a0"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
