<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    android:orientation="horizontal"
    android:padding="8dp" >

    <!-- Home / Return Button -->
    <ImageButton
        android:id="@+id/home_Button"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="5dp"
        android:layout_weight="0.08"
        android:background="@null"
        android:scaleType="fitStart"
        android:src="@drawable/button_image" />

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.92"
        android:orientation="vertical" >

        <!-- Top Header & Master Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp" >

            <TextView
                android:id="@+id/body_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BODY DOORS &amp; DRAWERS"
                android:textColor="#f6b93f"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_sync_dl"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/sound_button_image"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="SYNC DROIDLINK"
                android:textColor="#6bc7eb"
                android:textSize="11sp" />

            <Button
                android:id="@+id/button_master_open"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/default_button_image"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="ALL OPEN"
                android:textColor="#00ff00"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_master_close"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/default_button_image"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="ALL CLOSE"
                android:textColor="#ff6666"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Columns Container: Doors (Left) + Drawers (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" >

            <!-- Left Box: 6 Doors / Panels -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="6dp"
                android:layout_weight="0.45"
                android:background="@drawable/frame_attempt_2"
                android:orientation="vertical"
                android:padding="8dp" >

                <!-- Doors Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp" >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DOORS / PANELS (6)"
                        android:textColor="#6bc7eb"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/button_doors_open"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="OPEN ALL"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_doors_close"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="CLOSE ALL"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Doors 1 & 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_door_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Door 1 (UL)"
                        android:textColor="#e0ca64"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_door_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Door 2 (UR)"
                        android:textColor="#e0ca64"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Doors 3 & 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_door_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Door 3 (Mid L)"
                        android:textColor="#e0ca64"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_door_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Door 4 (Mid R)"
                        android:textColor="#e0ca64"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Doors 5 & 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_door_5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Door 5 (LL)"
                        android:textColor="#e0ca64"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_door_6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Door 6 (LR)"
                        android:textColor="#e0ca64"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Box: 8 Drawers -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_weight="0.55"
                android:background="@drawable/frame_attempt_2"
                android:orientation="vertical"
                android:padding="8dp" >

                <!-- Drawers Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp" >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BODY DRAWERS (8)"
                        android:textColor="#6bc7eb"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/button_drawers_open"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="OPEN ALL"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_drawers_close"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="CLOSE ALL"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Drawers 1 & 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_drawer_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 1"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_drawer_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 2"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Drawers 3 & 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_drawer_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 3"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_drawer_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 4"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Drawers 5 & 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_drawer_5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 5"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_drawer_6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 6"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Drawers 7 & 8 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_drawer_7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 7"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/button_drawer_8"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Drawer 8"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Status Line -->
        <TextView
            android:id="@+id/body_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ready | Tap any door or drawer to control"
            android:textColor="#a0a0a0"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
