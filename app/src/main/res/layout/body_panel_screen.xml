<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    android:orientation="horizontal"
    android:padding="6dp" >

    <!-- Home / Return Button -->
    <ImageButton
        android:id="@+id/home_Button"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="4dp"
        android:layout_weight="0.07"
        android:background="@null"
        android:scaleType="fitStart"
        android:src="@drawable/button_image" />

    <!-- Left Interactive Body Wireframe Graphic -->
    <FrameLayout
        android:id="@+id/body_wireframe_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="6dp"
        android:layout_weight="0.35" >

        <ImageView
            android:id="@+id/imageView_Selection_Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/body_selection_layer"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imageView_Body_Panels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/body_panel_wireframe" />

        <ImageView
            android:id="@+id/imageView_Body_Highlights"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Right Control Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical" >

        <!-- Top Selection & Action Bar for Wireframe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/frame_attempt_2"
            android:orientation="vertical"
            android:padding="5dp" >

            <!-- Row 1: Quick Select Buttons + Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:text="SELECT:"
                    android:textColor="#f6b93f"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_none"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="NONE"
                    android:textColor="#ff6666"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_doors"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="DOORS"
                    android:textColor="#e0ca64"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/button_sel_arms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="ARMS"
                    android:textColor="#e0ca64"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/button_sel_drawers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="DRAWERS"
                    android:textColor="#e0ca64"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/button_sel_all"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="ALL"
                    android:textColor="#e0ca64"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/button_sync_dl"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/sound_button_image"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="SYNC"
                    android:textColor="#6bc7eb"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: Actions on Selected Panels + Master All Open/Close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:text="SELECTED:"
                    android:textColor="#6bc7eb"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="OPEN"
                    android:textColor="#00ff00"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="CLOSE"
                    android:textColor="#ff6666"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="TOGGLE"
                    android:textColor="#e0ca64"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_master_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="ALL OPEN"
                    android:textColor="#00ff00"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/button_master_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="0dp"
                    android:text="ALL CLOSE"
                    android:textColor="#ff6666"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Columns Container: Doors & Arms (0-8) + Drawers (16-23) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" >

            <!-- Left Box: 9 Doors & Utility Arms (Outputs 0-8) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="0.52"
                android:background="@drawable/frame_attempt_2"
                android:orientation="vertical"
                android:padding="6dp" >

                <!-- Doors Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp" >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DOORS &amp; ARMS (0-8)"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/button_doors_open"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginRight="3dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:text="OPEN"
                        android:textColor="#e0ca64"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/button_doors_close"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:text="CLOSE"
                        android:textColor="#e0ca64"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Row 1: 0 (FRONT LEFT DOOR) & 1 (FRONT RIGHT DOOR) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="0: FRONT LEFT DOOR"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="1: FRONT RIGHT DOOR"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Row 2: 2 (BACK LEFT DOOR) & 3 (BACK RIGHT DOOR) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="2: BACK LEFT DOOR"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="3: BACK RIGHT DOOR"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Row 3: 4 (CHARGE BAY) & 5 (DATA PORT) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="4: CHARGE BAY"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="5: DATA PORT"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Row 4: 6 (SMALL DOOR) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="6: SMALL DOOR"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Row 5: 7 (UPPER UTIL ARM) & 8 (LOWER UTIL ARM) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="7: UPPER UTIL ARM"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_8"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="8: LOWER UTIL ARM"
                        android:textColor="#e0ca64"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Box: 8 Drawers (Outputs 16-23) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_weight="0.48"
                android:background="@drawable/frame_attempt_2"
                android:orientation="vertical"
                android:padding="6dp" >

                <!-- Drawers Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp" >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DRAWERS (16-23)"
                        android:textColor="#6bc7eb"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/button_drawers_open"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginRight="3dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:text="OPEN"
                        android:textColor="#e0ca64"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/button_drawers_close"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/default_button_image"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:text="CLOSE"
                        android:textColor="#e0ca64"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Drawers 1 (16) & 2 (17) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_16"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="16: DRAWER 1"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_17"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="17: DRAWER 2"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Drawers 3 (18) & 4 (19) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_18"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="18: DRAWER 3"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_19"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="19: DRAWER 4"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Drawers 5 (20) & 6 (21) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_20"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="20: DRAWER 5"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_21"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="21: DRAWER 6"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Drawers 7 (22) & 8 (23) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" >

                    <Button
                        android:id="@+id/button_body_22"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="22: DRAWER 7"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/button_body_23"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sound_button_image"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="23: DRAWER 8"
                        android:textColor="#6bc7eb"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Status Line -->
        <TextView
            android:id="@+id/body_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Tap panels on wireframe to select, or tap buttons to toggle (:BS00T - :BS23T)"
            android:textColor="#a0a0a0"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
