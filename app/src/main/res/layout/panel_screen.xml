<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    android:orientation="horizontal"
    android:padding="6dp" >

    <!-- Home / Return Button -->
    <ImageButton
        android:id="@+id/home_Button"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="4dp"
        android:layout_weight="0.07"
        android:background="@null"
        android:scaleType="fitStart"
        android:src="@drawable/button_image" />

    <!-- Left Interactive Dome Wireframe Graphic -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="6dp"
        android:layout_weight="0.35" >

        <ImageView
            android:id="@+id/imageView_Selection_Panels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel_selection_layer"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imageView_Panels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/dome_panel_wireframe" />

        <ImageView
            android:id="@+id/panel1_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel1_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel2_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel2_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel3_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel3_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel4_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel4_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel5_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel5_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel6_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel6_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel7_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel7_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel8_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel8_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel9_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel9_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel10_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel10_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel11_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel11_light"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/panel12_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/panel12_light"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Right Control Area (Matching Body Screen Top Bar + Sequence Pages Below) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical" >

        <!-- Top Selection & Action Bar for Dome Wireframe (Double Height + Enlarged Text) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/frame_attempt_2"
            android:orientation="vertical"
            android:padding="8dp" >

            <!-- Row 1: Quick Select Buttons + Sync (60dp height) -->
            <LinearLayout
                android:id="@+id/panel_selecter_lay"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:text="SELECT:"
                    android:textColor="#f6b93f"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_non"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="NONE"
                    android:textColor="#ff6666"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_but"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="BOT"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_top"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="TOP"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_all"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ALL"
                    android:textColor="#e0ca64"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sync_dl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_button_image"
                    android:padding="2dp"
                    android:text="SYNC"
                    android:textColor="#6bc7eb"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: Actions on Selected Dome Panels + Master All Open/Close (64dp height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/label_dome_selected_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:text="SELECTED:"
                    android:textColor="#6bc7eb"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.05"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="OPEN"
                    android:textColor="#00ff00"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.05"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="CLOSE"
                    android:textColor="#ff6666"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_sel_toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="TOGGLE"
                    android:textColor="#e0ca64"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_master_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ALL OPEN"
                    android:textColor="#00ff00"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_master_close"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:background="@drawable/default_button_image"
                    android:padding="2dp"
                    android:text="ALL CLOSE"
                    android:textColor="#ff6666"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lower Pager for Dome Sequences / Panel Control -->
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" >

            <TableLayout
                android:id="@+id/page_one"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/frame_attempt_2"
                android:padding="6dp" >

                <TableRow
                    android:id="@+id/tableRow0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_marginLeft="4dp"
                    android:baselineAligned="false" >

                    <TextView
                        android:id="@+id/textView1P"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PANEL CONTROL (PAGE 1):"
                        android:textColor="#f6b93f"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow1"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons1"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="ALL OPEN"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons2"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="ALL CLOSE"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons3"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="ALL OFF"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow2"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons4"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="OPEN"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons5"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="CLOSE"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons6"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="SERVO OFF"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow3"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons7"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="RC ON"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons8"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="RC HOLD"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons9"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="RC OFF"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow4"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons10"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="ALL RC"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons11"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="TOP RC"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons12"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="> >"
                        android:textColor="#00ff00"
                        android:textSize="14sp" />
                </TableRow>
            </TableLayout>

            <TableLayout
                android:id="@+id/page_two"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/frame_attempt_2"
                android:padding="6dp" >

                <TableRow
                    android:id="@+id/tableRow0P"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_marginLeft="4dp"
                    android:baselineAligned="false" >

                    <TextView
                        android:id="@+id/textView1P2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PANEL CONTROL (PAGE 2):"
                        android:textColor="#f6b93f"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow1P"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons13"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="STOP SEQ."
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons14"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="SCREAM"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons15"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="WAVE"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow2P"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons16"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="SMIRK WAVE"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons17"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="OPEN WAVE"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons18"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="ANTS MARCH"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow3P"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons19"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="FAINT"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons20"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="RYTHMIC"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons21"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="CLOSE ALL"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow4P"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false" >

                    <Button
                        android:id="@+id/buttons22"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="&lt; &lt;"
                        android:textColor="#00ff00"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons23"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="OPEN TOP"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttons24"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/default_button_image"
                        android:text="OPEN BOTTOM"
                        android:textColor="#e0ca64"
                        android:textSize="14sp" />
                </TableRow>
            </TableLayout>
        </androidx.viewpager.widget.ViewPager>

        <!-- Bottom Status Line -->
        <TextView
            android:id="@+id/dome_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Tap dome panels to select + OPEN/CLOSE/TOGGLE, or tap a Panel Control button"
            android:textColor="#a0a0a0"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>